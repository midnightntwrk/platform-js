{
  "$schema": "https://turbo.build/schema.v2.json",
  "envMode": "loose",
  "tasks": {
    "dist": {
      "inputs": ["src/**/*.ts", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["dist/**", "tsconfig.build.tsbuildinfo"],
      "outputLogs": "new-only",
      "dependsOn": ["^dist"]
    },
    "dist:publish": {
      "cache": false,
      "dependsOn": ["^dist:publish"]
    },
    "typecheck": {
      "inputs": ["src/**/*.ts", "test/**/*.ts", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputLogs": "new-only",
      "dependsOn": ["^dist"]
    },
    "test": {
      "inputs": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**", "reports/**"],
      "outputLogs": "new-only",
      "dependsOn": ["^dist"]
    },
    "lint": {
      "inputs": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig*.json",
        "vitest.config.ts",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/eslint.config.mjs"
      ],
      "outputLogs": "new-only",
      "dependsOn": ["^dist"]
    },
    "//#lint:root": {
      "inputs": ["eslint.config.mjs", "vitest.config.ts"],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false
    },
    "publint": {
      "inputs": ["src/**/*.ts", "package.json", "tsconfig*.json", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputLogs": "new-only",
      "dependsOn": ["dist:publish"]
    },
    "package": {
      "cache": false,
      "dependsOn": ["dist:publish"]
    }
  }
}
