{
  "name": "@midnightntwrk/platform-js-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dist": "turbo run dist",
    "dist:publish": "turbo run dist:publish",
    "watch": "turbo watch dist",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings 0 eslint.config.mjs vitest.config.ts vitest.outputs.ts vitest.tooling.config.ts test/tooling",
    "test:tooling": "vitest run --config vitest.tooling.config.ts",
    "typecheck:root": "tsc -p tsconfig.tooling.json",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "format:root": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore.root \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:check:root": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore.root \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:file": "prettier --write --ignore-unknown",
    "changed-files": "node scripts/changed-files.mjs",
    "format:changed": "node scripts/format-changed.mjs",
    "lint:changed": "turbo run lint lint:root --affected",
    "els:changed": "node scripts/els-changed.mjs",
    "verify": "turbo run verify",
    "verify:check": "turbo run verify:check",
    "verify:test": "turbo run verify:test",
    "verify:integration": "turbo run verify:integration",
    "verify:changed": "yarn format:changed && yarn lint:changed && yarn els:changed",
    "check-barrel-exports": "node scripts/check-barrel-exports.mjs",
    "clean": "turbo run clean",
    "publint": "turbo run publint",
    "package": "turbo run package",
    "changeset": "changeset",
    "changeset:check": "yarn changeset status --verbose"
  },
  "resolutions": {
    "tar": ">=7.5.11",
    "flatted": ">=3.4.2",
    "@isaacs/brace-expansion": ">=5.0.1",
    "glob": ">=13.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-jsdoc": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
