{
  "name": "@midnightntwrk/platform-js-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dist": "turbo run dist",
    "dist:publish": "turbo run dist:publish",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint --max-warnings 0 eslint.config.mjs vitest.config.ts",
    "clean": "turbo run clean",
    "publint": "turbo run publint",
    "package": "turbo run package",
    "changeset": "changeset",
    "changeset:check": "yarn changeset status --verbose"
  },
  "resolutions": {
    "tar": ">=7.5.11",
    "flatted": ">=3.4.2",
    "@isaacs/brace-expansion": ">=5.0.1",
    "glob": ">=13.0.1"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "@eslint/js": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "effect": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
