{
  "name": "@midnightntwrk/platform-js",
  "version": "4.0.0",
  "description": "Provides a set of core abstractions, utilities, and types for building services and libraries that work with the Midnight blockchain",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js",
      "default": "./dist/effect/index.js"
    },
    "./effect/*": {
      "types": "./dist/effect/*.d.ts",
      "import": "./dist/effect/*.js",
      "default": "./dist/effect/*.js"
    },
    "./effect/internal/*": null
  },
  "dependencies": {
    "@effect/platform": "^0.97.0",
    "effect": "^3.22.0",
    "tslib": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/platform-js.git",
    "directory": "packages/platform-js"
  },
  "author": "Midnight Foundation",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc -b ./tsconfig.json --noEmit --force",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0",
    "dist": "tsc -b ./tsconfig.build.json --force",
    "dist:publish": "rimraf --glob dist 'tsconfig.*.tsbuildinfo' && tsc -b ./tsconfig.publish.json",
    "clean": "rimraf --glob dist coverage reports 'tsconfig.*.tsbuildinfo' '*.tgz'",
    "publint": "publint --strict",
    "package": "npm pack"
  },
  "files": [
    "dist/",
    "!dist/**/*.map"
  ]
}
