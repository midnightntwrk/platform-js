{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "importHelpers": true,
    "composite": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "noPropertyAccessFromIndexSignature": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["vitest/globals", "node"]
  },
}
